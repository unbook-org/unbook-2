# ==========================================
# UnBook 2.0 - Variáveis de Ambiente
# Copie para backend/.env e preencha os valores marcados com <...>
# ==========================================

# Django
SECRET_KEY=<gere_uma_chave_aleatoria>
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19000,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Anonimato das avaliações (HMAC): gere um valor aleatório e nunca o altere depois
ANONYMOUS_SALT=

# Supabase (Postgres via Connection Pooler)
# Supabase > Project Settings > Database > Connection string > Session pooler
# Sem POSTGRES_DB o backend usa SQLite local
POSTGRES_DB=postgres
POSTGRES_USER=postgres.<project_ref>
POSTGRES_PASSWORD=<senha_do_banco>
POSTGRES_HOST=aws-0-<regiao>.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require
POSTGRES_CONN_MAX_AGE=0

# Redis 7
REDIS_URL=redis://redis:6379/0

# Meilisearch
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=unbook_meili_master_key_local

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
