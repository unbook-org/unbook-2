# ==========================================
# UnBook 2.0 - Variáveis de Ambiente Local
# ==========================================

# Django Settings
SECRET_KEY=django-insecure-dev-key-change-in-production-unbook2
DEBUG=True
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# PostgreSQL 16 + pgvector
POSTGRES_DB=unbook
POSTGRES_USER=unbook
POSTGRES_PASSWORD=unbook_secret
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis 7
REDIS_URL=redis://redis:6379/0

# Meilisearch
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=unbook_meili_master_key_local
